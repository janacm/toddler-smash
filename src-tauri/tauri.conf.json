{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toddler Smash",
  "version": "0.1.0",
  "identifier": "com.toddlersmash.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Toddler Smash",
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "focus": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "providerShortName": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGODg5NTk2ODg2M0VGQzMKUldURDcyT0lscFdJZjhpMDRmTXk1N0tCSjFWVHNuUnBVSHpiWUpLdjNoaFY3Ny9uL0JuemM4TjMK",
      "endpoints": [
        "https://github.com/janacm/toddler-smash/releases/latest/download/latest.json"
      ]
    }
    }
  }
}
