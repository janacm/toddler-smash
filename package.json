    "@vitest/coverage-v8": "^3.2.7",
    "happy-dom": "^21.0.1",
    "playwright": "^1.49.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  }
