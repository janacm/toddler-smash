  },
  "dmg": {
    "output_path": "src-tauri/target/release/bundle/dmg/Toddler Smash.dmg",
    "volume_name": "Toddler Smash"
  },
  "zip": {
    "output_path": "src-tauri/target/release/bundle/macos/Toddler-Smash-macOS.zip"
  }
}
